# Postgres (hrb_rag_retrieval / hrb_chat_feedback / hrb_chat_hitl schemas)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# Vector store (read-only from this service's point of view - ingestion owns writes)
ACTIVE_VECTOR_DB=chromadb
CHROMA_DB_MODE=persistent
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8000
CHROMA_DB_PERSIST_DIR=data/chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hrb-chatbot-kb
PINECONE_CLOUD=aws
PINECONE_ENVIRONMENT=us-east-1
PINECONE_METRIC=cosine
PINECONE_DIMENSION=1536

# Redis (STM/LTM memory, answer cache, rate limiter)
REDIS_URL=

# MCP (leave balance etc.) - real app-to-app OAuth2 client-credentials
HRB_LMS_MCP_URL=http://127.0.0.1:8190/mcp
HRB_LMS_MCP_OAUTH_TOKEN_URL=http://127.0.0.1:8190/oauth/token
HRB_LMS_MCP_OAUTH_CLIENT_ID=
HRB_LMS_MCP_OAUTH_CLIENT_SECRET=

# Observability
LOG_FORMAT=json
LANGSMITH_API_KEY=
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=rag_retrieval_service
